# Optional. If set, transcription uses the OpenAI Whisper API (fast, paid,
# ~$0.006/min). If left blank or unset, the app automatically falls back to
# a free local Whisper model (slower on a laptop CPU, no cost, no account).
OPENAI_API_KEY=

# Optional. Only used for the free local model. One of: tiny, base, small,
# medium, large-v3, large-v3-turbo. Bigger = more accurate and slower.
# Defaults to "large-v3-turbo" (most of large-v3's accuracy, close to
# small/medium speed). Drop to "small" or "base" if it's too slow.
WHISPER_LOCAL_MODEL=large-v3-turbo
